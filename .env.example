# Copy to .env and fill in. NEVER commit .env.

# --- Server ---
NEXUS_LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR
NEXUS_LOG_FORMAT=console        # console | json  (logs always go to stderr)
NEXUS_TRANSPORT=stdio           # stdio | streamable-http
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8000
NEXUS_REQUEST_TIMEOUT_S=15
NEXUS_MAX_RESULTS=25

# --- Safety: writes are OFF by default ---
NEXUS_ALLOW_WRITES=false
NEXUS_ALLOW_DELETES=false

# --- Supabase ---
SUPABASE_URL=
SUPABASE_KEY=                   # prefer an anon/restricted key; service key only if needed

# --- Notion ---
NOTION_TOKEN=

# --- Supabase access policy ---
SUPABASE_SCHEMA=public
SUPABASE_ALLOWED_TABLES=        # comma list; empty = every table the key can read
SUPABASE_WRITABLE_TABLES=       # comma list; writes are refused for any table not listed
SUPABASE_SEARCH_COLUMNS=        # e.g. notes:title|body,docs:title  (feeds unified search)
NEXUS_MAX_WRITE_ROWS=50         # refuse writes that would touch more rows than this

# --- Notion access policy ---
NOTION_API_VERSION=2022-06-28
NOTION_WRITABLE_PARENTS=        # comma list of database/page IDs or URLs; writes only under these

# --- Demo mode: fictional sample sources, no accounts needed ---
NEXUS_DEMO_MODE=false

# --- Hardening ---
NEXUS_HTTP_AUTH_TOKEN=          # >= 32 chars; REQUIRED to bind HTTP to a non-loopback host
NEXUS_ALLOWED_HOSTS=            # extra Host values for HTTP behind a proxy, e.g. mcp.example.com
NEXUS_AUDIT_LOG_PATH=           # JSONL audit trail for writes (recommended whenever writes are on)
NEXUS_RATE_LIMIT_READS_PER_MIN=120   # 0 disables
NEXUS_RATE_LIMIT_WRITES_PER_MIN=30   # 0 disables
NEXUS_TOOL_TIMEOUT_S=30
NEXUS_MAX_PAYLOAD_BYTES=100000  # cap on write payloads and returned page text
NEXUS_MAX_CELL_CHARS=4000       # longer values in returned rows are truncated
